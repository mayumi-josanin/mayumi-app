# コピーして .env にし、値を入れる。
#   cp .env.example .env

# 長いランダムな文字列。次で作れる:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# GAS からの呼び出しを確かめる合鍵。上と同じ作り方でよい。
# ここを空のままにすると、API はすべて拒否する（素通しにはならない）。
API_KEY=

DB_PASSWORD=

# Funnel で公開する名前。例: mayumi-api.tail8efe0d.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# KEM_DDENKI と重ならないようにずらしてある
DB_PORT=5434
WEB_PORT=8002

# ---- まゆみ専用の入り口を立てるとき（docker-compose.tailscale.yml）----

# Tailscale 管理画面で発行する認証キー。
#   https://login.tailscale.com/admin/settings/keys
# 一度きりで構わない（覚え書きを volume に残すので、再起動では要らない）。
# **発行したら、立ち上げたあとに管理画面で mayumi-api の
#   「キーの期限切れ」を無効にすること。**既定の180日で切れると、
#   その日にお客様のアプリがサーバーを見失う。
TS_AUTHKEY=

# 専用の入り口を使い始めたら、この行の # を外す。
#
# **外し忘れると事故ります。**
# docker compose は、指定されていないサービスを「余りもの」と見なす。
# うっかり `docker compose up -d --remove-orphans` を打つと、
# まゆみの出口ごと消えて、外から届かなくなる。
# ここに書いておけば、いつもの `docker compose up -d` で両方が揃う。
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml

# /dev/net/tun が使えないときだけ true にする（少し遅くなるが動く）
#TS_USERSPACE=true

# ---- アプリが直接見に行くようになったら使うもの ----

# 住所をまたぐ通信を許す相手。カンマ区切り。**`*` にしないこと。**
# `*` にすると、見知らぬページの JavaScript からも、お客様の合鍵さえあれば読める。
# 既定は GitHub Pages の配布先。確認用の場所を足すときはここに並べる。
CORS_ALLOWED_ORIGINS=https://mayumi-josanin.github.io

# 1分あたりの呼び出しの上限（相手ごと）。
# お客様1人がアプリを開いて出す通信は多くても数十件なので、既定は120。
THROTTLE_PER_MINUTE=120

# ログインやパスコードの復旧など、当てずっぽうを繰り返される道の上限。
THROTTLE_STRICT_PER_MINUTE=10
